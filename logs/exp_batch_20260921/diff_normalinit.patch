>     valid = np.isfinite(dist)                                                          # [n, k]
>     count = valid.sum(1)
>     nb = cloud[np.where(valid, idx, 0)]                                                # [n, k, 3]
>     w = valid[..., None].astype(np.float64)
>     mean = (nb * w).sum(1) / np.clip(count, 1, None)[:, None]
>     d = (nb - mean[:, None, :]) * w
>     cov = np.einsum("nki,nkj->nij", d, d)
